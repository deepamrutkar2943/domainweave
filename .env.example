# DomainWeave environment configuration template
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control.

# ── Application identity ──────────────────────────────────────────────────────
APP_NAME=DomainWeave
APP_VERSION=0.1.0

# ── Runtime environment ───────────────────────────────────────────────────────
# Allowed values: development | testing | production
ENVIRONMENT=development

# ── Logging ───────────────────────────────────────────────────────────────────
# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Model providers ───────────────────────────────────────────────────────────
# Active provider. Supported: openai | nvidia_nim
MODEL_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# NVIDIA NIM (OpenAI-compatible)
# MODEL_PROVIDER=nvidia_nim
# NVIDIA_NIM_API_KEY=nvapi-...
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Database (added in Milestone 5) ───────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/domainweave

# ── LangSmith tracing (added in Milestone 7) ─────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=domainweave

